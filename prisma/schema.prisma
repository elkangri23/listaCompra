generator client {
  provider      = "prisma-client-js"
  // El builder Docker es node:20-alpine sin binario openssl: Prisma detecta
  // "linux-musl", pero el runner (Alpine con OpenSSL 3) necesita
  // "linux-musl-openssl-3.0.x". Sin este target el contenedor api entra
  // en bucle de reinicios (PrismaClientInitializationError).
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                 String      @id @default(uuid())
  email              String      @unique
  password           String
  nombre             String
  apellidos          String?
  rol                RolUsuario  @default(USUARIO)
  activo             Boolean     @default(true)
  emailVerificado    Boolean     @default(false)
  terminosAceptadosEn DateTime?
  eliminacionSolicitadaEn DateTime?
  fechaCreacion      DateTime    @default(now())
  fechaActualizacion DateTime    @updatedAt
  blueprints         Blueprint[]
  listas             Lista[]
  permisos           Permiso[]
  productos          Producto[]

  // MFA (TOTP) — feature CU-MFA fase 1
  totpSecret       String?
  totpEnabled      Boolean @default(false)
  totpPendIntentos Int     @default(0)

  backupCodes   MfaBackupCode[]
  mfaChallenges MfaChallenge[]
  passkeys      PasskeyCredential[]
  emailVerificationCodes EmailVerificationCode[]
  passwordResetCodes     PasswordResetCode[]

  @@map("usuarios")
}

model Lista {
  id                 String       @id @default(uuid())
  nombre             String
  descripcion        String?
  color              String?
  icono              String?
  activa             Boolean      @default(true)
  fechaCreacion      DateTime     @default(now())
  fechaActualizacion DateTime     @updatedAt
  propietarioId      String
  invitaciones       Invitacion[]
  propietario        Usuario      @relation(fields: [propietarioId], references: [id], onDelete: Cascade)
  permisos           Permiso[]
  productos          Producto[]

  @@map("listas")
}

model Producto {
  id                 String     @id @default(uuid())
  nombre             String
  descripcion        String?
  cantidad           Int        @default(1)
  unidad             String?
  precio             Decimal?
  comprado           Boolean    @default(false)
  urgente            Boolean    @default(false)
  orden              Int        @default(0)
  fechaCreacion      DateTime   @default(now())
  fechaActualizacion DateTime   @updatedAt
  fechaCompra        DateTime?
  listaId            String
  categoriaId        String?
  creadoPorId        String
  categoria          Categoria? @relation(fields: [categoriaId], references: [id])
  creadoPor          Usuario    @relation(fields: [creadoPorId], references: [id], onDelete: Cascade)
  lista              Lista      @relation(fields: [listaId], references: [id], onDelete: Cascade)

  @@map("productos")
}

model Categoria {
  id                 String     @id @default(uuid())
  nombre             String
  descripcion        String?
  color              String?
  icono              String?
  activa             Boolean    @default(true)
  fechaCreacion      DateTime   @default(now())
  fechaActualizacion DateTime   @updatedAt
  tiendaId           String?
  tienda             Tienda?    @relation(fields: [tiendaId], references: [id])
  productos          Producto[]

  @@unique([nombre, tiendaId])
  @@map("categorias")
}

model Tienda {
  id                 String      @id @default(uuid())
  nombre             String      @unique
  direccion          String?
  telefono           String?
  sitioWeb           String?
  activa             Boolean     @default(true)
  fechaCreacion      DateTime    @default(now())
  fechaActualizacion DateTime    @updatedAt
  categorias         Categoria[]

  @@map("tiendas")
}

model Invitacion {
  id              String      @id @default(uuid())
  hash            String      @unique
  emailInvitado   String?
  fechaCreacion   DateTime    @default(now())
  fechaExpiracion DateTime
  listaId         String
  activa          Boolean     @default(true)
  tipoPermiso     TipoPermiso @default(LECTURA)
  lista           Lista       @relation(fields: [listaId], references: [id], onDelete: Cascade)

  @@map("invitaciones")
}

model Permiso {
  id            String      @id @default(uuid())
  fechaCreacion DateTime    @default(now())
  usuarioId     String
  listaId       String
  tipoPermiso   TipoPermiso
  lista         Lista       @relation(fields: [listaId], references: [id], onDelete: Cascade)
  usuario       Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, listaId])
  @@map("permisos")
}

model Blueprint {
  id                 String   @id @default(uuid())
  nombre             String
  descripcion        String?
  publico            Boolean  @default(false)
  contenido          Json
  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt
  creadoPorId        String
  creadoPor          Usuario  @relation(fields: [creadoPorId], references: [id], onDelete: Cascade)

  @@map("blueprints")
}

model OutboxEvent {
  id            String    @id @default(uuid())
  aggregateId   String
  eventType     String
  eventData     Json
  processed     Boolean   @default(false)
  attempts      Int       @default(0)
  aggregateType String
  createdAt     DateTime  @default(now())
  eventContext  Json?
  eventId       String    @unique
  eventVersion  Int       @default(1)
  lastAttemptAt DateTime?
  lastError     String?
  occurredOn    DateTime
  processedAt   DateTime?
  updatedAt     DateTime  @updatedAt

  @@index([processed, createdAt])
  @@index([eventType, processed])
  @@index([aggregateId, aggregateType])
  @@index([occurredOn])
  @@map("outbox_events")
}

model AuditEntry {
  id              String   @id @default(uuid())
  entityType      String // e.g., 'Lista', 'Producto'
  entityId        String // ID of the entity that was changed
  changeType      String // e.g., 'CREATE', 'UPDATE', 'DELETE'
  changedByUserId String? // ID of the user who made the change (optional, for system changes)
  timestamp       DateTime @default(now())
  oldValue        Json? // JSON representation of the entity before the change
  newValue        Json? // JSON representation of the entity after the change
  changedFields   Json? // JSON array of strings indicating which fields were modified

  @@index([entityType, entityId])
  @@index([changedByUserId])
  @@index([timestamp])
  @@map("audit_entries")
}

enum RolUsuario {
  USUARIO
  ADMIN
}

// =================================
// MFA (TOTP) — fase 1
// =================================

/// Código de respaldo de un solo uso (hash HMAC-SHA256, nunca en claro tras la emisión)
model MfaBackupCode {
  id        String    @id @default(uuid())
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  codeHash  String
  usado     Boolean   @default(false)
  usadoAt   DateTime?
  createdAt DateTime  @default(now())

  @@index([usuarioId])
  @@map("mfa_backup_codes")
}

/// Challenge de login MFA de un solo uso (una fila por intento)
model MfaChallenge {
  id        String   @id @default(uuid())
  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo      String // 'TOTP' | 'PASSKEY_REG' | 'PASSKEY_LOGIN'
  challenge String? // challenge WebAuthn (base64url) — fase 2
  intentos  Int      @default(0)
  createdAt DateTime @default(now())
  expiraAt  DateTime

  @@index([usuarioId])
  @@index([tipo])
  @@index([expiraAt])
  @@map("mfa_challenges")
}

// Código de verificación de email (item 3): 6 dígitos, solo se guarda el
// HMAC del código, nunca el código en claro. Un solo uso, 15 min de vida.
model EmailVerificationCode {
  id        String   @id @default(uuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  codeHash  String
  intentos  Int      @default(0)
  expiraAt  DateTime
  usado     Boolean  @default(false)
  usadoAt   DateTime?
  createdAt DateTime @default(now())

  @@index([usuarioId])
  @@index([expiraAt])
  @@map("email_verification_codes")
}

model PasswordResetCode {
  id        String   @id @default(uuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  codeHash  String
  intentos  Int      @default(0)
  expiraAt  DateTime
  usado     Boolean  @default(false)
  usadoAt   DateTime?
  createdAt DateTime @default(now())

  @@index([usuarioId])
  @@index([expiraAt])
  @@map("password_reset_codes")
}

enum TipoPermiso {
  LECTURA
  ESCRITURA
  ADMIN
}

/// Credencial passkey (WebAuthn) del usuario — fase 2
model PasskeyCredential {
  id           String    @id @default(uuid())
  credentialId String    @unique
  usuarioId    String
  usuario      Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  publicKey    Bytes
  contador     Int       @default(0)
  transports   String[]  @default([])
  deviceType   String    @default("singleDevice")
  aaguid       String?
  nombre       String    @default("Passkey")
  activo       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  ultimoUso    DateTime?

  @@index([usuarioId])
  @@map("webauthn_credentials")
}

/// Eventos de uso real de IA (panel admin, fase 3): un evento por llamada
/// real al modelo. `userId` es siempre null hoy (agregados globales) y
/// NO tiene FK: la telemetría no debe interferir con la cascada GDPR
/// de borrado de cuenta.
model AIUsageEvent {
  id        String   @id @default(uuid())
  userId    String?
  provider  String
  model     String
  operation String // 'category-suggestions' | 'bulk-categorize' | 'config-test'
  latencyMs Int
  success   Boolean
  cached    Boolean
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([operation])
  @@map("ai_usage_events")
}

/// Intentos de inicio de sesión (panel admin, fase 5): un evento por
/// intento de login, correcto o fallido, con el motivo real que distingue
/// AuthenticateUser. `email` se guarda normalizado en minúsculas; NUNCA
/// se guardan contraseñas, códigos ni tokens. Sin FK a usuarios: un
/// intento puede ser de un email inexistente, y la telemetría no debe
/// interferir con la cascada GDPR de borrado de cuenta (igual que
/// ai_usage_events). Base del overview, las alertas y la futura retención
/// de la pestaña Métricas (ultimaConexion se deriva de aquí).
model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  success   Boolean
  reason    String? // 'WRONG_PASSWORD' | 'USER_NOT_FOUND' | 'UNVERIFIED_EMAIL' | 'INACTIVE_ACCOUNT' | 'MFA_FAILED'
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([createdAt])
  @@map("login_attempts")
}

/// Copias de seguridad reales de la base de datos (panel admin, fase 6).
///
/// CICLO DE VIDA (el backend solo REGISTRA y EXPONE; el trabajo pesado lo
/// hacen scripts del host + cron en el VPS, porque el contenedor de la API
/// no puede ejecutar comandos del host ni docker exec):
///
///   PENDING   → solicitud manual registrada por POST /admin/backups.
///               El watcher (backup-watcher.sh, cada 5 min) la recoge y
///               ejecuta backup-prod.sh <id>.
///   CREATED   → el dump existe en /opt/listacompra/backups/ y la fila
///               lleva filename y sizeBytes reales. También es el estado
///               de las copias programadas (source SCHEDULED, sin pasar
///               por PENDING) y de la copia pre-restore (salvavidas).
///   FAILED    → la creación falló; el motivo va en `failureReason`
///               (NUNCA en restoreReason: ese campo es solo de
///               restauraciones) y el detalle en el log del script.
///   RESTORING → solicitud de restauración registrada por
///               POST /admin/backups/:id/restore (confirmación RESTAURAR
///               + motivo). Significa a la vez "solicitada, pendiente de
///               procesar" y "en curso": el watcher la recoge (por
///               restoreRequestedAt no nulo) y delega en restore-prod.sh,
///               que es el único que toca producción. Mientras haya una
///               fila RESTORING no se acepta otra restauración (409).
///   RESTORED  → la restauración terminó bien; restoredAt = cuando se
///               completó. restoreReason guarda el motivo que dio el admin.
///   RESTORE_FAILED → el ensayo o algún paso falló; el motivo va en
///               `failureReason`. Si falló ANTES de tocar producción, la
///               base no se tocó; si falló DESPUÉS, el log del script lo
///               dice y la copia pre-restore permite revertir a mano.
///
/// Sin FK a usuarios: una copia programada no tiene creador, y la
/// telemetría no debe interferir con la cascada GDPR de borrado de
/// cuenta (igual que ai_usage_events y login_attempts).
model Backup {
  id                      String    @id @default(uuid())
  filename                String
  sizeBytes               Int       @default(0) // 0 mientras PENDING
  status                  String // 'PENDING' | 'CREATED' | 'FAILED' | 'RESTORING' | 'RESTORED' | 'RESTORE_FAILED'
  source                  String // 'SCHEDULED' | 'MANUAL'
  createdByUserId         String?
  createdAt               DateTime  @default(now())
  /// Motivo de la restauración, dado por el admin que la solicitó.
  restoreReason           String?
  restoredAt              DateTime?
  /// Cuándo se solicitó la restauración (distingue "solicitada, pendiente"
  /// de "en curso": el watcher procesa las RESTORING con este campo).
  restoreRequestedAt      DateTime?
  restoreRequestedByUserId String?
  /// Motivo del fallo de creación (FAILED) o de restauración
  /// (RESTORE_FAILED). El detalle completo queda en el log del script.
  failureReason           String?

  @@index([status, createdAt])
  @@index([createdAt])
  @@map("backups")
}
