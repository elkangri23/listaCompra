# =================================
# CONFIGURACIÓN DE LA APLICACIÓN
# =================================

# Entorno de ejecución (development, production, test)
NODE_ENV=development

# Puerto del servidor
PORT=3333

# URL base de la aplicación
APP_URL=http://localhost:3333

# =================================
# CONFIGURACIÓN DE BASE DE DATOS
# =================================

# URL de conexión a PostgreSQL
# Formato: postgresql://usuario:contraseña@host:puerto/base_de_datos
DATABASE_URL=postgresql://lista_user:lista_password@localhost:5432/lista_compra_db

# Configuración de pool de conexiones
DB_POOL_MIN=2
DB_POOL_MAX=10

# =================================
# CONFIGURACIÓN DE AUTENTICACIÓN
# =================================

# Clave secreta para JWT (REQUERIDO - debe ser criptográficamente seguro)
# Generar con: openssl rand -hex 64  (o con el comando node de abajo)
# ⚠️ NUNCA commitear un valor real aquí: reemplaza este placeholder por tu secreto.
JWT_SECRET=REEMPLAZAR_POR_SECRETO_GENERADO_CON_openssl_rand_hex_64

# Tiempo de expiración del token de acceso (en segundos o formato like '1h', '30m', '7d')
JWT_ACCESS_EXPIRES_IN=1h

# Tiempo de expiración del token de refresh (en segundos o formato like '1h', '30m', '7d')
JWT_REFRESH_EXPIRES_IN=7d

# Algoritmo de encriptación para JWT
JWT_ALGORITHM=HS256

# =================================
# CONFIGURACIÓN DE RABBITMQ
# =================================

# URL de conexión a RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Configuración de intercambios y colas
RABBITMQ_EXCHANGE_NAME=lista_compra_exchange
RABBITMQ_QUEUE_NOTIFICATIONS=notifications_queue
RABBITMQ_QUEUE_AUDIT=audit_queue
RABBITMQ_QUEUE_DLQ=dead_letter_queue

# Configuración de reconexión
RABBITMQ_RECONNECT_ATTEMPTS=5
RABBITMQ_RECONNECT_DELAY=5000

# =================================
# CONFIGURACIÓN DE EMAIL (RESEND)
# =================================

# Habilitar/deshabilitar envío de emails
EMAIL_ENABLED=true

# API Key de Resend (REQUERIDO)
# Obtén tu API key en: https://resend.com/api-keys
# IMPORTANTE: NUNCA commitear esta clave a Git
RESEND_API_KEY=

# Nombre del remitente
EMAIL_FROM_NAME=Lista de Compra

# Dirección del remitente (debe estar verificada en Resend)
# Nota: Para desarrollo puedes usar "onboarding@resend.dev"
# Para producción, verifica tu propio dominio en Resend
EMAIL_FROM=onboarding@resend.dev

# Configuración de retry y timeouts
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_DELAY=1000

# URL base para enlaces en emails
EMAIL_BASE_URL=http://localhost:3333

# =================================
# CONFIGURACIÓN DE IA
# =================================

# (La configuración IA detallada está en la sección "CONFIGURACIÓN DE SERVICIOS DE IA" de abajo)
OPENAI_TEMPERATURE=0.7

# Configuración de timeouts para servicios de IA
AI_REQUEST_TIMEOUT=30000
AI_MAX_RETRIES=3

# =================================
# CONFIGURACIÓN DE LOGGING
# =================================

# Nivel de logging (error, warn, info, debug)
LOG_LEVEL=info

# Formato de logs (json, simple)
LOG_FORMAT=json

# Directorio para archivos de log
LOG_DIR=./logs

# Tamaño máximo de archivo de log
LOG_MAX_SIZE=10m

# Número máximo de archivos de log
LOG_MAX_FILES=5

# =================================
# CONFIGURACIÓN DE SEGURIDAD
# =================================

# Configuración de rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Configuración de CORS
# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGIN=http://localhost:3333,http://localhost:8080
CORS_CREDENTIALS=true

# Configuración de Helmet
HELMET_ENABLED=true

# =================================
# CONFIGURACIÓN DE SERVICIOS DE IA
# =================================

# Proveedor de IA por defecto (freellmapi, perplexity, openai, openai-compatible,
# anthropic, google, openrouter, azure-openai)
# Por defecto: freellmapi (gratuito, OpenAI-compatible)
AI_PROVIDER=freellmapi

# --- FreeLLMAPI (proveedor por defecto) ---
# Registra tu API key gratuita y consulta los modelos disponibles en su web.
FREE_LLMAPI_API_KEY=your_freellmapi_key_here
FREE_LLMAPI_API_URL=https://api.electronhub.ai/v1
FREE_LLMAPI_MODEL=gpt-4o-mini

# --- OpenAI (opcional) ---
OPENAI_API_KEY=sk-tu_clave_de_openai_aqui
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic Claude - API NATIVA /v1/messages (opcional) ---
ANTHROPIC_API_KEY=sk-ant-tu_clave_de_anthropic_aqui
ANTHROPIC_API_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# --- Google Gemini - API NATIVA generateContent (opcional) ---
GOOGLE_API_KEY=your_google_ai_studio_key_here
GOOGLE_API_URL=https://generativelanguage.googleapis.com
GOOGLE_MODEL=gemini-1.5-flash

# --- OpenAI-compatible personalizado (vLLM, LM Studio, Ollama, LiteLLM...) ---
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_API_URL=http://localhost:11434/v1
OPENAI_COMPATIBLE_MODEL=llama3.1

# --- Perplexity (opcional, era el proveedor por defecto antes) ---
PERPLEXITY_API_KEY=your_perplexity_api_key_here
PERPLEXITY_API_URL=https://api.perplexity.ai
PERPLEXITY_MODEL=sonar

# --- OpenRouter (opcional) ---
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# Temperatura para respuestas de IA (0.0 - 1.0)
AI_TEMPERATURE=0.7

# Máximo de tokens en respuestas
AI_MAX_TOKENS=1000

# Timeout para requests de IA (en milisegundos)
AI_TIMEOUT=30000

# Cache TTL para respuestas de IA (en segundos)
AI_CACHE_TTL=3600

# Habilitar cache de respuestas de IA
AI_CACHE_ENABLED=true

# Límite de requests por minuto para IA
AI_RATE_LIMIT_PER_MINUTE=10

# =================================
# CONFIGURACIÓN DE TESTING
# =================================

# URL de base de datos para testing
TEST_DATABASE_URL=postgresql://lista_user:lista_password@localhost:5433/lista_compra_test_db

# =================================
# CONFIGURACIÓN DE OBSERVABILIDAD
# =================================

# Configuración de métricas
METRICS_ENABLED=true
METRICS_PORT=9090

# Configuración de tracing
TRACING_ENABLED=false
TRACING_SERVICE_NAME=lista-compra-api

# =================================
# CONFIGURACIÓN DE DESARROLLO
# =================================

# Habilitar documentación Swagger en desarrollo
SWAGGER_ENABLED=true

# Habilitar logs de consultas SQL en desarrollo
DEBUG_SQL=false

# Habilitar modo de depuración
DEBUG_MODE=false

# =================================
# MFA (TOTP) — fase 1
# =================================
# Clave maestra AES-256-GCM (32 bytes en base64). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# PELIGRO: perderla = todos los TOTP inaccesibles (runbook en spec MFA §10)
MFA_ENCRYPTION_KEY=

# Flags de rollout de MFA (rutas backend). Frontend usa NEXT_PUBLIC_FF_*
FF_MFA_ENABLED=true
FF_PASSKEYS_ENABLED=false

# WebAuthn (fase 2 — passkeys)
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME=ListaCompra
# WEBAUTHN_ORIGIN=http://localhost:3000
